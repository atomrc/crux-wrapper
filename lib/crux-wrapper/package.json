{
  "name": "crux-wrapper",
  "version": "3.4.2",
  "description": "A React provider for your crux application",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react/index.js"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --fix && prettier --check .",
    "lint:fix": "eslint . --ext .ts,.tsx --fix && prettier --write .",
    "test": "vitest"
  },
  "keywords": [
    "crux",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "19.2.15",
    "@typescript-eslint/types": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "react": "^19"
  }
}
